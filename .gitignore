# Generated by install.py / scripts/build-agents.py with this machine's absolute
# paths: the files every install links to (dist/), and this repo's own links.
# Regenerate with: python3 install.py (or python3 scripts/build-agents.py)
/dist/
/.claude/agents/
/.claude/commands/
/.claude/skills/
/.claude/settings.json.orc-backup
/.claude/settings.local.json
/.claude/worktrees/
*.orc-tmp

# Local tooling
/.codegraph/
__pycache__/
*.pyc
.DS_Store

# Claude Code type declarations the plugin tooling drops in for the editor;
# not ours to publish, and regenerated by the tooling.
/mods/*/.claude-plugin/types/
node_modules/

# Written into a mod folder by `herdr-app check` for the editor; per Herdr version.
/herdr-app/mods/*/gpui-kit.d.ts
/herdr-app/mods/*/jsconfig.json
