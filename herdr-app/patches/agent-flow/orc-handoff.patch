+// orc.py (herdr-orchestrators) opens a role pane and hands it its task in one call:
+// `orc.py [--as <agent>] ensure <role> [--name <pane>] ... --handoff <file>`. The pane is
+// named after `--name`, else the role. Without `--handoff` it only opens the pane.
+const ORC_ENSURE = /(?:^|[\s;&|/\\"'])orc(?:\.py)?["']?\s+(?:--as[\s=]\S+\s+)?ensure\s+["']?([\w.-]+)([^;&|\n]*)/i;
+
+// Who a tool call is talking to: `hc send <target>` from a shell, an orc.py handoff, or
+// Claude Code's SendMessage. Only the target leaves here, never the message.
 function target(name, input = {}) {
   if (name === "SendMessage" && input.to) return String(input.to);
   if (typeof input.command !== "string") return null;
   const hit = /(?:^|[\s;&|/\\"'])hc(?:\.exe)?["']?\s+send\s+(?:--?[a-z-]+\s+)*["']?([\w:./-]+)/i.exec(input.command);
